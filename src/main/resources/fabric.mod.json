{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.BloodyDreamsWork.backport.Backport"
    ],
    "client": [
      "dev.BloodyDreamsWork.backport.client.BackportClient"
    ]
  },
  "mixins": [
    "backport.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25"
  }
}
